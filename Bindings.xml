        key fires whatever aspect occupies ExsarAddonAspectBtnN. Labels resolve
        via BINDING_NAME_EXSAR_ASPECTN globals set by ExsarUI.CreateActionBar.
    -->
    <Binding name="EXSAR_ASPECT1" header="EXSARADDONASPECTS" category="ExsarAddon Aspects"/>
    <Binding name="EXSAR_ASPECT2" category="ExsarAddon Aspects"/>
    <Binding name="EXSAR_ASPECT3" category="ExsarAddon Aspects"/>
    <Binding name="EXSAR_ASPECT4" category="ExsarAddon Aspects"/>
    <Binding name="EXSAR_ASPECT5" category="ExsarAddon Aspects"/>
    <Binding name="EXSAR_ASPECT6" category="ExsarAddon Aspects"/>

